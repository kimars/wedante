# 이 파일을 복사해서 .env 로 저장하고 값을 채우세요:  cp .env.example .env

SECRET_KEY=change-this-to-a-random-string

# PostgreSQL 연결 정보 (docker-compose로 로컬 실행 시 아래 값 그대로 사용 가능)
DATABASE_URL=postgresql://wedante:wedante@localhost:5432/wedante

# 개인정보(환불계좌 등) 암호화 키. 아래 명령으로 생성한 값을 고정해서 사용하세요.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 값을 비워두면 실행할 때마다 임시 키가 생성되어 재시작 후 기존 데이터를 복호화할 수 없습니다.
ENCRYPTION_KEY=

# 솔라피(https://solapi.com) 문자 발송 API - 비워두면 콘솔 출력으로 대체(개발용)
# 발신번호는 반드시 solapi 콘솔에서 사전등록된 번호여야 하며 하이픈 없이 입력
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=

# Google Gemini API (상대선수 분석용) - 비워두면 규칙 기반 fallback 분석 사용
# 발급: https://aistudio.google.com/apikey
# 모델은 선택 사항 (미지정 시 gemini-3.5-flash 사용)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
